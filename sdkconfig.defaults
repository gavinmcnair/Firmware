# sdkconfig defaults for the hybrid (framework = arduino, espidf) envs -- today
# only esp32-s3-N16R8-pm. Arduino-only envs never read this file: they link the
# precompiled arduino-libs, whose baked-in sdkconfig has power management
# compiled OUT (no CONFIG_PM_ENABLE, no tickless idle, BLE controller sleep
# mode 0 -- verified against framework-arduinoespressif32-libs/esp32s3/sdkconfig).
# This file exists to turn exactly those on; everything else mirrors the stock
# Arduino build so NimBLE-Arduino and the rest of the firmware see the same
# environment they were validated against.

#
# Arduino-as-component baseline (required by the Arduino core)
#
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y

#
# Board: Seeed XIAO ESP32-S3 Plus class -- 16MB QIO flash, 8MB octal PSRAM
# (matches board_build.arduino.memory_type = qio_opi on the arduino-only twin)
#
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

#
# BLE: same host arrangement as the stock arduino-libs (IDF NimBLE host,
# which NimBLE-Arduino 2.x wraps on arduino-esp32 3.x), PLUS controller
# modem sleep -- the piece the stock build lacks. No external 32kHz crystal
# on the XIAO, so the controller's low-power clock is the main XTAL, which
# must then stay powered through light sleep.
#
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y

#
# Power management: DFS + automatic light sleep (armed by esp_pm_configure()
# in main.cpp, gated on CONFIG_PM_ENABLE) + RF power-down in light sleep.
#
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_ESP_PHY_MAC_BB_PD=y

#
# TLS-PSK for the LAN transport (wifi_service.cpp's mbedtls_ssl_conf_psk):
# enabled in the stock arduino-libs mbedtls, disabled in bare IDF defaults.
#
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y

#
# Task watchdog parity with the arduino-only envs' 120s setting
#
CONFIG_ESP_TASK_WDT_TIMEOUT_S=120
